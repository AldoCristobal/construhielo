---
import SectionHeader from '../ui/SectionHeader.astro';

const contactItems = [
  {
    label: 'Teléfono oficina',
    val:   '222 590 1004',
    href:  'tel:2225901004',
    ico:   'M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z',
  },
  {
    label: 'Correo',
    val:   'construhielo@gmail.com',
    href:  'mailto:construhielo@gmail.com',
    ico:   'M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z',
  },
  {
    label: 'Taller y oficinas',
    val:   'Puebla, México',
    href:  null,
    ico:   'M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z M15 11a3 3 0 11-6 0 3 3 0 016 0z',
  },
];

const productos = [
  'Máquina de Rolito',
  'Tanque de Barras',
  'Cámara Frigorífica',
  'Evaporador Industrial',
  'Mantenimiento / Reparación',
  'Otro / Asesoría',
];
---

<section id="contacto" class="py-28 bg-[--surface2] relative" aria-labelledby="cont-h">

  <div class="absolute inset-x-0 top-0 h-px"
       style="background:linear-gradient(90deg,transparent,rgba(35,90,140,0.2),transparent);"
       aria-hidden="true"></div>

  <div class="max-w-7xl mx-auto px-5 lg:px-10">

    <div class="mb-14">
      <SectionHeader
        tag="Contacto"
        title="CUÉNTANOS<br/>QUÉ NECESITAS"
        id="cont-h"
        subtitle="Sin compromisos. Con los datos básicos de tu proyecto te enviamos una propuesta técnica y económica real."
      />
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-[1fr_360px] gap-12 lg:gap-16">

      <!-- ── Formulario ── -->
      <div data-reveal="left" data-delay="100">
        <form id="cform" class="space-y-5" novalidate aria-label="Formulario de contacto">

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
            <div>
              <label class="mono-tag text-[9px] text-[--muted] block mb-2" for="fn">Nombre *</label>
              <input id="fn" name="nombre" type="text" required autocomplete="name"
                     class="field" placeholder="Tu nombre"/>
            </div>
            <div>
              <label class="mono-tag text-[9px] text-[--muted] block mb-2" for="fe">Empresa</label>
              <input id="fe" name="empresa" type="text" class="field" placeholder="Nombre de tu empresa"/>
            </div>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
            <div>
              <label class="mono-tag text-[9px] text-[--muted] block mb-2" for="fem">Correo *</label>
              <input id="fem" name="email" type="email" required autocomplete="email"
                     class="field" placeholder="tucorreo@ejemplo.com"/>
            </div>
            <div>
              <label class="mono-tag text-[9px] text-[--muted] block mb-2" for="ft">Teléfono *</label>
              <input id="ft" name="tel" type="tel" required autocomplete="tel"
                     class="field" placeholder="222 000 0000"/>
            </div>
          </div>

          <div>
            <label class="mono-tag text-[9px] text-[--muted] block mb-2" for="fp">Equipo de interés *</label>
            <select id="fp" name="producto" required class="field">
              <option value="" disabled selected>Seleccionar…</option>
              {productos.map(p => <option>{p}</option>)}
            </select>
          </div>

          <div>
            <label class="mono-tag text-[9px] text-[--muted] block mb-2" for="fm">Describe tu proyecto *</label>
            <textarea id="fm" name="mensaje" required rows="5" class="field resize-none"
                      placeholder="Capacidad requerida, ubicación, refrigerante si lo sabes, plazo estimado…"></textarea>
          </div>

          <div class="flex flex-wrap items-center gap-5 pt-1">
            <button type="submit" class="btn btn-primary">
              Enviar solicitud
              <svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </button>
            <p id="fst" class="mono-tag text-[10px] hidden" aria-live="polite"></p>
          </div>
        </form>
      </div>

      <!-- ── Info lateral ── -->
      <aside class="space-y-4" data-reveal="right" data-delay="200">

        <!-- Wrapper relativo para anclar la mascota -->
        <div class="relative">

          <!-- Mascota saliendo del borde derecho de la card -->
          <img
            src="/images/mascota.png"
            alt=""
            class="absolute bottom-0 right-0 w-40 lg:w-52 pointer-events-none select-none drop-shadow-xl"
            style="transform: translateX(80%) scaleX(-1); z-index: 10;"
            aria-hidden="true"
            loading="lazy"
            draggable="false"
          />

        <div class="card bg-white p-6 relative">
          <div class="ctl absolute top-3 left-3"></div>
          <p class="mono-tag text-ice-500 text-[10px] mb-6">DATOS DE CONTACTO</p>
          <div class="space-y-5">
            {contactItems.map(c => (
              <div class="flex gap-4 items-start">
                <div class="w-8 h-8 border border-[--border] bg-paper-50 flex items-center justify-center flex-shrink-0">
                  <svg width="13" height="13" viewBox="0 0 24 24" fill="none" class="text-ice-500" aria-hidden="true">
                    <path d={c.ico} stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </div>
                <div>
                  <p class="mono-tag text-[8px] text-[--muted] mb-0.5">{c.label}</p>
                  {c.href
                    ? <a href={c.href} class="text-steel-700 text-sm hover:text-steel-500 transition-colors">{c.val}</a>
                    : <p class="text-steel-700 text-sm">{c.val}</p>
                  }
                </div>
              </div>
            ))}
          </div>
        </div>
        </div><!-- /wrapper mascota -->

        <!-- WhatsApp CTA -->
        <a href="https://wa.me/522228494578?text=Hola,%20me%20interesa%20cotizar%20un%20equipo%20de%20ConstruHielo"
           target="_blank" rel="noopener noreferrer"
           class="flex items-center gap-4 p-5 border border-[#25d366]/25 bg-white
                  hover:bg-[#f0fdf4] hover:border-[#25d366]/50 transition-all duration-300 group">
          <div class="w-10 h-10 rounded-full bg-[#25d366] flex items-center justify-center flex-shrink-0">
            <svg width="20" height="20" fill="white" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
            </svg>
          </div>
          <div>
            <p class="text-steel-800 text-sm font-semibold group-hover:text-steel-700 transition-colors">
              Escríbenos por WhatsApp
            </p>
            <p class="mono-tag text-[9px] text-[--muted]">222 849 4578 · Respuesta rápida</p>
          </div>
          <svg class="ml-auto text-[#25d366] opacity-0 group-hover:opacity-100 transition-opacity"
               width="15" height="15" fill="none" viewBox="0 0 16 16" aria-hidden="true">
            <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
          </svg>
        </a>

        <!-- Badge respuesta -->
        <div class="border border-[--border] bg-white p-4 flex items-center gap-3">
          <span class="w-2 h-2 rounded-full bg-ice-400 animate-blink flex-shrink-0"></span>
          <div>
            <p class="text-steel-800 text-sm font-semibold">Respondemos en menos de 24 h</p>
            <p class="mono-tag text-[9px] text-[--muted]">Para urgencias, llama directo a oficina</p>
          </div>
        </div>

      </aside>
    </div>
  </div>
</section>

<style>
  .field {
    @apply w-full bg-white border border-[--border] text-steel-800 px-4 py-3 text-sm
           placeholder-[--muted] outline-none transition-all duration-200;
    font-family: 'Plus Jakarta Sans', sans-serif;
  }
  .field:focus {
    border-color: rgba(34,187,212,0.55);
    box-shadow: 0 0 0 3px rgba(34,187,212,0.08);
  }
  select.field option { background: white; color: #1c3348; }
</style>

<script>
  const form = document.getElementById('cform') as HTMLFormElement | null;
  const fst  = document.getElementById('fst');

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!form || !fst) return;

    const d   = new FormData(form);
    const req = ['nombre','email','tel','producto','mensaje'];

    if (req.some(k => !String(d.get(k) ?? '').trim())) {
      fst.textContent = '⚠ Completa los campos requeridos.';
      fst.className   = 'mono-tag text-[10px] text-amber-500';
      fst.classList.remove('hidden');
      return;
    }

    const btn = form.querySelector('button[type=submit]') as HTMLButtonElement;
    btn.disabled    = true;
    btn.textContent = 'Enviando…';

    await new Promise(r => setTimeout(r, 900));

    fst.textContent = '✓ Solicitud enviada — te contactaremos pronto.';
    fst.className   = 'mono-tag text-[10px] text-ice-600';
    fst.classList.remove('hidden');
    form.reset();
    btn.disabled    = false;
    btn.textContent = 'Enviar solicitud';
  });
</script>
