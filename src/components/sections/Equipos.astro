---
import SectionHeader from '../ui/SectionHeader.astro';
import { EQUIPOS } from '../../data/equipos';
---

<section id="equipos" class="py-28 bg-[--surface2] relative" aria-labelledby="eq-h">

  <div class="absolute inset-x-0 top-0 h-px"
       style="background:linear-gradient(90deg,transparent,rgba(35,90,140,0.2),transparent);"
       aria-hidden="true"></div>

  <div class="max-w-7xl mx-auto px-5 lg:px-10">

    <!-- Encabezado -->
    <div class="flex flex-col lg:flex-row lg:items-end justify-between gap-6 mb-14" data-reveal>
      <SectionHeader
        tag="Equipos"
        title="TODO SALE<br/>DE NUESTRO TALLER"
        id="eq-h"
      />
      <p class="text-[--muted] text-sm max-w-xs leading-relaxed">
        Fabricado en Puebla. Sin importaciones, sin intermediarios.
        Control total del proceso, el material y el precio final.
      </p>
    </div>

    <!-- ── SLIDER PRINCIPAL ── -->
    <div class="grid grid-cols-1 lg:grid-cols-[1fr_420px] gap-6 lg:gap-10">

      <!-- ── Columna izquierda: Diagrama + Galería ── -->
      <div>

        <!-- Panel del diagrama -->
        <div class="border border-[--border] bg-white relative overflow-hidden" style="height:460px" id="eq-diagram">
          <div class="ctl absolute top-3 left-3 z-10"></div>
          <div class="cbr absolute bottom-3 right-3 z-10"></div>

          <!-- Tag + Número -->
          <div class="absolute top-5 left-6 right-6 flex items-center justify-between z-10">
            <span id="eq-tag"
                  class="mono-tag text-[9px] px-2 py-1 bg-steel-50 border border-[--border] text-ice-600">
              {EQUIPOS[0].tag}
            </span>
            <span id="eq-num"
                  class="display text-7xl text-steel-100 select-none leading-none">
              {EQUIPOS[0].num}
            </span>
          </div>

          <!-- Canvases SVG -->
          {EQUIPOS.map((eq, idx) => (
            <div
              id={`eq-canvas-${eq.id}`}
              class:list={[
                'absolute inset-0 transition-opacity duration-500',
                idx === 0 ? 'opacity-100' : 'opacity-0',
              ]}
              aria-hidden="true"
            >
              <svg viewBox="0 0 420 560" fill="none" class="w-full h-full">
                {eq.id === 'rolito' && (
                  <g>
                    <text x="210" y="50" font-family="Space Mono,monospace" font-size="9"
                          fill="rgba(35,90,140,0.4)" text-anchor="middle" letter-spacing="1">
                      MÁQUINA DE ROLITO
                    </text>
                    <circle cx="210" cy="290" r="180" fill="rgba(34,187,212,0.04)" stroke="rgba(35,90,140,0.12)" stroke-width="1.5"/>
                    <circle cx="210" cy="290" r="140" fill="rgba(34,187,212,0.06)" stroke="rgba(35,90,140,0.1)" stroke-width="1"/>
                    <circle cx="210" cy="290" r="22"  fill="rgba(34,187,212,0.2)"  stroke="rgba(34,187,212,0.5)" stroke-width="1.5"/>
                    <circle cx="210" cy="290" r="6"   fill="#22bbd4"/>
                    {Array.from({length:18}).map((_,i) => {
                      const a = (i/18)*Math.PI*2;
                      return (
                        <g>
                          <circle cx={210+Math.cos(a)*90} cy={290+Math.sin(a)*90} r="22" fill="white" stroke="rgba(35,90,140,0.2)" stroke-width="1.2"/>
                          <circle cx={210+Math.cos(a)*90} cy={290+Math.sin(a)*90} r="14" fill="rgba(34,187,212,0.08)" stroke="rgba(34,187,212,0.25)" stroke-width="0.8"/>
                          <line x1={210+Math.cos(a)*32} y1={290+Math.sin(a)*32}
                                x2={210+Math.cos(a)*130} y2={290+Math.sin(a)*130}
                                stroke="rgba(35,90,140,0.08)" stroke-width="0.8" stroke-dasharray="3 3"/>
                        </g>
                      );
                    })}
                    <text x="210" y="510" font-family="Space Mono,monospace" font-size="8"
                          fill="rgba(35,90,140,0.4)" text-anchor="middle" letter-spacing="1">
                      HIELO TUBULAR · CORTE TRANSVERSAL
                    </text>
                  </g>
                )}
                {eq.id === 'barras' && (
                  <g>
                    <text x="210" y="50" font-family="Space Mono,monospace" font-size="9"
                          fill="rgba(35,90,140,0.4)" text-anchor="middle" letter-spacing="1">
                      TANQUE DE BARRAS
                    </text>
                    <rect x="60" y="80" width="300" height="380" rx="3" fill="rgba(34,187,212,0.05)" stroke="rgba(35,90,140,0.2)" stroke-width="1.5"/>
                    <path d="M62 260 Q100 255 135 260 Q175 265 210 260 Q245 255 280 260 Q315 265 358 260 L358 458 L62 458 Z" fill="rgba(34,187,212,0.07)"/>
                    {Array.from({length:3}).map((_,row) =>
                      Array.from({length:4}).map((_,col) => (
                        <g>
                          <rect x={72+col*66} y={90+row*54} width="56" height="36" rx="2" fill="white" stroke="rgba(35,90,140,0.18)" stroke-width="1"/>
                          <rect x={75+col*66} y={93+row*54} width="50" height="30" rx="1" fill="rgba(34,187,212,0.1)"/>
                          <line x1={100+col*66} y1={93+row*54} x2={100+col*66} y2={123+row*54} stroke="rgba(34,187,212,0.3)" stroke-width="0.8"/>
                          <line x1={75+col*66}  y1={108+row*54} x2={125+col*66} y2={108+row*54} stroke="rgba(34,187,212,0.3)" stroke-width="0.8"/>
                        </g>
                      ))
                    )}
                    <text x="210" y="510" font-family="Space Mono,monospace" font-size="8"
                          fill="rgba(35,90,140,0.4)" text-anchor="middle" letter-spacing="1">
                      SALMUERA CaCl₂ · −8 a −12°C
                    </text>
                  </g>
                )}
                {eq.id === 'camara' && (
                  <g>
                    <text x="210" y="50" font-family="Space Mono,monospace" font-size="9"
                          fill="rgba(35,90,140,0.4)" text-anchor="middle" letter-spacing="1">
                      CÁMARA FRIGORÍFICA
                    </text>
                    <rect x="60" y="80" width="300" height="360" rx="3" fill="rgba(34,187,212,0.04)" stroke="rgba(35,90,140,0.2)" stroke-width="1.5"/>
                    {Array.from({length:5}).map((_,i) => (
                      <line x1="60" y1={80+i*72} x2="360" y2={80+i*72} stroke="rgba(35,90,140,0.06)" stroke-width="0.8"/>
                    ))}
                    {Array.from({length:5}).map((_,i) => (
                      <line x1={60+i*60} y1="80" x2={60+i*60} y2="440" stroke="rgba(35,90,140,0.06)" stroke-width="0.8"/>
                    ))}
                    <rect x="120" y="340" width="60" height="100" rx="2" fill="rgba(34,187,212,0.1)" stroke="rgba(35,90,140,0.3)" stroke-width="1.5"/>
                    <rect x="140" y="360" width="20" height="40" rx="1" fill="rgba(34,187,212,0.2)"/>
                    <rect x="230" y="100" width="90" height="60" rx="2" fill="white" stroke="rgba(35,90,140,0.2)" stroke-width="1"/>
                    <text x="275" y="136" font-family="Space Mono,monospace" font-size="10" fill="rgba(34,187,212,0.8)" text-anchor="middle">−18°C</text>
                    {[130,200,270,340].map(x => (
                      <path d={`M${x} 140 Q${x+10} 120 ${x+20} 140 Q${x+30} 160 ${x+40} 140`}
                            stroke="rgba(34,187,212,0.3)" stroke-width="1" fill="none"/>
                    ))}
                    <text x="210" y="510" font-family="Space Mono,monospace" font-size="8"
                          fill="rgba(35,90,140,0.4)" text-anchor="middle" letter-spacing="1">
                      PANEL PIR/PUR · PUERTA ISOTÉRMICA
                    </text>
                  </g>
                )}
                {eq.id === 'evap' && (
                  <g>
                    <text x="210" y="50" font-family="Space Mono,monospace" font-size="9"
                          fill="rgba(35,90,140,0.4)" text-anchor="middle" letter-spacing="1">
                      CONDENSADOR INDUSTRIAL
                    </text>
                    <ellipse cx="210" cy="290" rx="100" ry="175" fill="rgba(34,187,212,0.04)" stroke="rgba(35,90,140,0.2)" stroke-width="1.5"/>
                    {Array.from({length:7}).map((_,i) => (
                      <ellipse cx="210" cy={210+i*24} rx="66" ry="10" fill="white" stroke="rgba(35,90,140,0.15)" stroke-width="0.9"/>
                    ))}
                    <rect x="178" y="100" width="64" height="22" rx="2" fill="rgba(34,187,212,0.1)" stroke="rgba(35,90,140,0.3)" stroke-width="1"/>
                    <text x="210" y="115" font-family="Space Mono,monospace" font-size="7" fill="rgba(35,90,140,0.6)" text-anchor="middle">NH₃ IN</text>
                    <rect x="178" y="445" width="64" height="22" rx="2" fill="rgba(35,90,140,0.08)" stroke="rgba(35,90,140,0.3)" stroke-width="1"/>
                    <text x="210" y="460" font-family="Space Mono,monospace" font-size="7" fill="rgba(35,90,140,0.6)" text-anchor="middle">NH₃ OUT</text>
                    <rect x="272" y="268" width="58" height="44" rx="2" fill="white" stroke="rgba(35,90,140,0.25)" stroke-width="1"/>
                    <text x="301" y="286" font-family="Space Mono,monospace" font-size="7" fill="rgba(35,90,140,0.5)" text-anchor="middle">ASME</text>
                    <text x="301" y="300" font-family="Space Mono,monospace" font-size="7" fill="rgba(34,187,212,0.7)" text-anchor="middle">✓</text>
                    <text x="210" y="510" font-family="Space Mono,monospace" font-size="8"
                          fill="rgba(35,90,140,0.4)" text-anchor="middle" letter-spacing="1">
                      CASCO Y TUBO · NH₃ / FREON
                    </text>
                  </g>
                )}
              </svg>
            </div>
          ))}

          <!-- Botón Cotiza -->
          <div class="absolute bottom-8 left-6 z-10">
            <a href="#contacto" class="btn btn-primary text-[10px]">
              Cotiza Ahora
              <svg width="12" height="12" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </a>
          </div>

          <!-- Dots de navegación -->
          <div class="absolute bottom-9 right-6 flex items-center gap-2 z-10">
            {EQUIPOS.map((_, i) => (
              <button
                class:list={['eq-dot', i === 0 ? 'is-active' : '']}
                data-to={String(i)}
                aria-label={`Ir a equipo ${i + 1}`}
              ></button>
            ))}
          </div>
        </div>

        <!-- Galería de fotos -->
        <div class="grid grid-cols-3 gap-3 mt-3">

          <!-- Foto real 1 -->
          <a href="/images/productos/evaporador.png"
             class="glightbox border border-[--border] bg-steel-900 relative overflow-hidden group block"
             data-gallery="eq-gallery"
             data-title="Evaporador Industrial — ConstruHielo"
             style="aspect-ratio:16/9"
             aria-label="Ver evaporador en tamaño completo">
            <div class="ctl absolute top-2 left-2 z-10"></div>
            <img
              src="/images/productos/evaporador.png"
              alt="Evaporador industrial ConstruHielo"
              class="w-full h-full object-cover object-center transition-transform duration-500 group-hover:scale-105"
              loading="lazy"
            />
            <div class="absolute inset-0 flex items-center justify-center bg-black/0 group-hover:bg-black/20 transition-colors duration-300">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none"
                   class="text-white opacity-0 group-hover:opacity-100 transition-opacity duration-300 drop-shadow" aria-hidden="true">
                <path d="M15 3h6v6M9 21H3v-6M21 3l-7 7M3 21l7-7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </div>
          </a>

          <!-- Foto real 2 -->
          <a href="/images/productos/condensador.png"
             class="glightbox border border-[--border] bg-white relative overflow-hidden group block"
             data-gallery="eq-gallery"
             data-title="Condensador Industrial — ConstruHielo"
             style="aspect-ratio:16/9"
             aria-label="Ver condensador en tamaño completo">
            <div class="ctl absolute top-2 left-2 z-10"></div>
            <img
              src="/images/productos/condensador.png"
              alt="Condensador industrial ConstruHielo"
              class="w-full h-full object-contain object-center transition-transform duration-500 group-hover:scale-105 p-1"
              loading="lazy"
            />
            <div class="absolute inset-0 flex items-center justify-center bg-black/0 group-hover:bg-black/20 transition-colors duration-300">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none"
                   class="text-white opacity-0 group-hover:opacity-100 transition-opacity duration-300 drop-shadow" aria-hidden="true">
                <path d="M15 3h6v6M9 21H3v-6M21 3l-7 7M3 21l7-7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </div>
          </a>

          <!-- Placeholder: más fotos próximamente -->
          <div class="border border-[--border] border-dashed bg-steel-50 relative overflow-hidden flex flex-col items-center justify-center gap-2"
               style="aspect-ratio:16/9">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none"
                 class="text-steel-300" aria-hidden="true">
              <path d="M23 19a2 2 0 01-2 2H3a2 2 0 01-2-2V8a2 2 0 012-2h4l2-3h6l2 3h4a2 2 0 012 2z"
                    stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              <circle cx="12" cy="13" r="4" stroke="currentColor" stroke-width="1.5"/>
            </svg>
            <p class="mono-tag text-[8px] text-steel-300">MÁS FOTOS</p>
          </div>

        </div>
      </div>

      <!-- ── Columna derecha: Controles + Card animada ── -->
      <div class="flex flex-col">

        <!-- Controles de navegación -->
        <div class="flex items-center gap-4 mb-5">
          <button id="eq-prev"
                  class="w-9 h-9 border border-[--border] flex items-center justify-center text-[--muted] hover:border-steel-400 hover:text-steel-700 transition-all"
                  aria-label="Equipo anterior">
            <svg width="13" height="13" viewBox="0 0 16 16" fill="none" aria-hidden="true">
              <path d="M10 4L6 8l4 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </button>
          <span id="eq-counter" class="mono-tag text-[10px] text-[--muted] tabular-nums">
            01 / 0{EQUIPOS.length}
          </span>
          <button id="eq-next"
                  class="w-9 h-9 border border-[--border] flex items-center justify-center text-[--muted] hover:border-steel-400 hover:text-steel-700 transition-all"
                  aria-label="Equipo siguiente">
            <svg width="13" height="13" viewBox="0 0 16 16" fill="none" aria-hidden="true">
              <path d="M6 4l4 4-4 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </button>
        </div>

        <!-- Track de cards (apiladas en grid, una visible a la vez) -->
        <div id="eq-track">
          {EQUIPOS.map((eq, idx) => (
            <div class:list={['eq-slide', idx === 0 ? 'is-active' : '']} data-idx={String(idx)}>
              <div class="card bg-white p-7 relative h-full">
                <div class="cbr absolute bottom-3 right-3"></div>

                <span class="mono-tag text-[9px] text-ice-500">{eq.tag}</span>

                <div class="flex items-start justify-between mt-2 mb-5">
                  <div>
                    <h3 class="display text-3xl text-steel-900 leading-tight">{eq.title}</h3>
                    <p class="mono-tag text-[9px] text-[--muted] mt-1">{eq.sub}</p>
                  </div>
                  <span class="display text-5xl text-steel-100 select-none flex-shrink-0 ml-3 leading-none">
                    {eq.num}
                  </span>
                </div>

                <p class="text-[--muted] text-sm leading-relaxed mb-6">{eq.desc}</p>

                <div class="grid grid-cols-2 gap-2">
                  {eq.specs.map(s => (
                    <div class="border border-[--border] px-3 py-2.5">
                      <p class="mono-tag text-[8px] text-[--muted]">{s.k}</p>
                      <p class="text-steel-700 text-xs font-medium mt-0.5">{s.v}</p>
                    </div>
                  ))}
                </div>
              </div>
            </div>
          ))}
        </div>

      </div>
    </div><!-- /grid -->

  </div>
</section>

<style>
  /* ── Slider track: apila todas las slides en la misma celda ── */
  #eq-track {
    display: grid;
  }
  .eq-slide {
    grid-area: 1 / 1;
    opacity: 0;
    pointer-events: none;
    transform: translateY(10px);
  }
  .eq-slide.is-active {
    opacity: 1;
    pointer-events: auto;
    transform: none;
    animation: eq-enter 0.38s cubic-bezier(0.4,0,0.2,1) both;
  }
  @keyframes eq-enter {
    from { opacity: 0; transform: translateY(14px); }
    to   { opacity: 1; transform: none; }
  }

  /* ── Dots ── */
  .eq-dot {
    width: 6px; height: 6px;
    border-radius: 9999px;
    background: rgba(35,90,140,0.2);
    border: none; cursor: pointer; padding: 0;
    transition: background 0.3s, width 0.3s;
  }
  .eq-dot.is-active {
    background: #22bbd4;
    width: 18px;
  }

  /* ── Transición suave del tag/num del diagrama ── */
  #eq-tag, #eq-num {
    transition: opacity 0.25s ease;
  }
  #eq-tag.fading, #eq-num.fading {
    opacity: 0;
  }
</style>

<script>
  import GLightbox from 'glightbox';
  import 'glightbox/dist/css/glightbox.min.css';

  GLightbox({
    selector: '.glightbox',
    touchNavigation: true,
    loop: true,
    closeButton: true,
    zoomable: true,
  });

  interface EqData { id: string; tag: string; num: string; }

  const EQ: EqData[] = [
    { id: 'rolito', tag: 'Producción de hielo',    num: '01' },
    { id: 'barras', tag: 'Hielo en bloque',         num: '02' },
    { id: 'camara', tag: 'Almacenamiento en frío',  num: '03' },
    { id: 'evap',   tag: 'Transferencia de calor',  num: '04' },
  ];

  let current = 0;
  const TOTAL  = EQ.length;

  const slides   = Array.from(document.querySelectorAll<HTMLElement>('.eq-slide'));
  const canvases = Array.from(document.querySelectorAll<HTMLElement>('[id^="eq-canvas-"]'));
  const dots     = Array.from(document.querySelectorAll<HTMLElement>('.eq-dot'));
  const tagEl    = document.getElementById('eq-tag');
  const numEl    = document.getElementById('eq-num');
  const counter  = document.getElementById('eq-counter');

  function goTo(next: number) {
    if (next === current || next < 0 || next >= TOTAL) return;

    // Deactivate current slide
    slides[current].classList.remove('is-active');

    // Activate next (remove first to retrigger animation)
    slides[next].classList.remove('is-active');
    void (slides[next] as HTMLElement).offsetWidth; // force reflow
    slides[next].classList.add('is-active');

    // Canvases
    canvases.forEach((c, i) => {
      c.style.opacity = i === next ? '1' : '0';
    });

    // Tag + Num fade swap
    [tagEl, numEl].forEach(el => el?.classList.add('fading'));
    setTimeout(() => {
      if (tagEl) tagEl.textContent = EQ[next].tag;
      if (numEl) numEl.textContent = EQ[next].num;
      [tagEl, numEl].forEach(el => el?.classList.remove('fading'));
    }, 250);

    // Counter
    if (counter) counter.textContent = `${String(next + 1).padStart(2, '0')} / 0${TOTAL}`;

    // Dots
    dots.forEach((d, i) => {
      d.classList.toggle('is-active', i === next);
    });

    current = next;
  }

  document.getElementById('eq-prev')?.addEventListener('click', () => goTo(current - 1));
  document.getElementById('eq-next')?.addEventListener('click', () => goTo(current + 1));

  dots.forEach((dot, i) => dot.addEventListener('click', () => goTo(i)));

  // Soporte teclado ← →
  document.addEventListener('keydown', (e: KeyboardEvent) => {
    const sec = document.getElementById('equipos');
    if (!sec) return;
    const rect = sec.getBoundingClientRect();
    if (rect.top > window.innerHeight || rect.bottom < 0) return;
    if (e.key === 'ArrowRight') goTo(current + 1);
    if (e.key === 'ArrowLeft')  goTo(current - 1);
  });
</script>
