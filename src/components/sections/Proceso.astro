---
import SectionHeader from '../ui/SectionHeader.astro';
import { PASOS } from '../../data/proceso';
---

<section id="proceso" class="py-28 bg-white relative" aria-labelledby="proc-h">

  <div class="max-w-7xl mx-auto px-5 lg:px-10">

    <div class="mb-16 max-w-2xl">
      <SectionHeader
        tag="Cómo trabajamos"
        title="SIN SORPRESAS,<br/>SIN INTERMEDIARIOS"
        id="proc-h"
        subtitle="Cinco etapas claras. Sabes exactamente qué pasa en cada momento, quién lo ejecuta y cuándo lo recibes."
      />
    </div>

    <div class="relative">
      <!-- Línea vertical conectora (desktop) -->
      <div
        class="absolute left-[1.375rem] sm:left-[2.25rem] top-10 bottom-10 w-px bg-gradient-to-b from-ice-200 via-steel-200 to-ice-200 hidden lg:block"
        aria-hidden="true"
      ></div>

      <div class="space-y-4">
        {PASOS.map((p, i) => (
          <div class="group relative flex gap-3 sm:gap-6 lg:gap-10 items-start" data-reveal data-delay={String(i*100)}>

            <!-- Nodo -->
            <div class="relative z-10 flex-shrink-0 w-11 h-11 sm:w-16 sm:h-16 lg:w-[4.5rem] lg:h-[4.5rem]
                        border-2 border-steel-200 bg-steel-50 flex flex-col items-center justify-center
                        group-hover:border-ice-400 group-hover:bg-white transition-all duration-300">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none"
                   class="text-steel-500 group-hover:text-ice-500 transition-colors mb-0.5" aria-hidden="true">
                <path d={p.icon} stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
              <span class="mono-tag text-[9px] text-steel-500">{p.num}</span>
            </div>

            <!-- Card -->
            <div class="card bg-white flex-1 p-5 lg:p-8 relative
                        group-hover:border-steel-200 group-hover:shadow-[0_4px_20px_rgba(35,90,140,0.07)]">
              <div class="cbr absolute bottom-3 right-3"></div>
              <h3 class="display text-2xl lg:text-3xl text-steel-900 mb-3 group-hover:text-steel-700 transition-colors">
                {p.title}
              </h3>
              <p class="text-steel-600 text-base leading-relaxed">{p.desc}</p>
              <div class="absolute bottom-0 left-0 h-[3px] w-0 bg-gradient-to-r from-ice-400 to-steel-400
                          group-hover:w-full transition-all duration-500"></div>
            </div>
          </div>
        ))}
      </div>
    </div>

  </div>
</section>
