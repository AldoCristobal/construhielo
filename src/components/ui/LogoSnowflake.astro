---
interface Props {
  variant?: 'light' | 'dark';
  href?: string;
  height?: number;
  /** No usados en render pero aceptados para evitar warnings de TypeScript */
  animate?: boolean;
  textSize?: string;
}

const {
  variant = 'light',
  href    = '#inicio',
  height  = 44,
} = Astro.props;

const src = variant === 'dark'
  ? '/images/logo/logo-light.png'
  : '/images/logo/logo-dark.png';
---

<a href={href} class="flex items-center" aria-label="ConstruHielo inicio">
  <img
    src={src}
    alt="ConstruHielo — Refrigeración Industrial"
    height={height}
    width={height * 4}
    style={`height:${height}px;width:auto;`}
    loading="eager"
    decoding="async"
  />
</a>
