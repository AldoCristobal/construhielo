interface Props {
  title:        string;
  description?: string;
  ogImage?:     string;
}

const {
  title,
  description = 'ConstruHielo â€” MÃ¡s de 30 aÃ±os diseÃ±ando y fabricando equipos de refrigeraciÃ³n industrial en Puebla, MÃ©xico. FÃ¡bricas de hielo, cÃ¡maras frigorÃ­ficas y sistemas a medida.',
  ogImage = '/images/logo/logo-dark.png',
} = Astro.props;

const siteUrl     = (Astro.site?.href ?? 'https://construhielo.com.mx').replace(/\/$/, '');
const canonical   = Astro.url.href;
const ogImageFull = ogImage.startsWith('http') ? ogImage : `${siteUrl}${ogImage}`;

const jsonLd = {
  '@context':   'https://schema.org',
  '@type':      'LocalBusiness',
  'name':       'ConstruHielo',
  'description': description,
  'url':        siteUrl,
  'telephone':  '+52-222-590-1004',
  'email':      'construhielo@gmail.com',
  'foundingDate': '1994',
  'image':      ogImageFull,
  'logo':       ogImageFull,
  'address': {
    '@type':           'PostalAddress',
    'streetAddress':   'Guadalupe Victoria 4',
    'addressLocality': 'Puebla',
    'addressRegion':   'Puebla',
    'postalCode':      '72120',
    'addressCountry':  'MX',
  },
  'geo': {
    '@type':     'GeoCoordinates',
    'latitude':   19.057,
    'longitude': -98.209,
  },
  'openingHoursSpecification': {
    '@type':      'OpeningHoursSpecification',
    'dayOfWeek':  ['Monday','Tuesday','Wednesday','Thursday','Friday'],
    'opens':      '08:00',
    'closes':     '18:00',
  },
};
---

<!doctype html>
