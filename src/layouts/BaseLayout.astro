    </svg>
  </a>

  <!-- Mascota fija â€” aparece solo cuando #contacto estÃ¡ en pantalla -->
  <img
    src="/images/mascota.webp"
    alt=""
    id="mascota-fixed"
    class="pointer-events-none select-none drop-shadow-2xl"
    style="
      display: none;
      position: fixed;
      bottom: 0;
      right: 0;
      width: 120px;
      transform: scaleX(-1);
      z-index: 40;
      transition: opacity 0.4s ease, transform 0.4s ease;
      opacity: 0;
    "
    aria-hidden="true"
    loading="lazy"
    draggable="false"
  />

</body>
</html>

<script>
  // â”€â”€ Mascota â€” solo visible cuando #contacto estÃ¡ en pantalla (desktop) â”€â”€
  const mascota  = document.getElementById('mascota-fixed') as HTMLElement | null;
  const contacto = document.getElementById('contacto');

  let mascotaObserver: IntersectionObserver | null = null;

  if (mascota && contacto && window.matchMedia('(min-width: 1024px)').matches) {
    mascotaObserver = new IntersectionObserver(
      ([entry]) => {
        if (entry.isIntersecting) {
          mascota.style.display = 'block';
          requestAnimationFrame(() => {
            mascota.style.opacity = '1';
            mascota.style.transform = 'scaleX(-1) translateY(0)';
          });
        } else {
          mascota.style.opacity = '0';
          mascota.style.transform = 'scaleX(-1) translateY(30px)';
          setTimeout(() => { mascota.style.display = 'none'; }, 400);
        }
      },
      { threshold: 0.1 }
    );
    mascotaObserver.observe(contacto);
  }

  // â”€â”€ Scroll reveal â”€â”€
  const revealObs = new IntersectionObserver(
    entries => entries.forEach(e => {
      if (e.isIntersecting) {
        e.target.classList.add('visible');
        revealObs.unobserve(e.target);
      }
    }),
    { threshold: 0.10, rootMargin: '0px 0px -32px 0px' }
  );
  document.querySelectorAll('[data-reveal]').forEach(el => revealObs.observe(el));

  // â”€â”€ Contador animado â”€â”€
  const COUNTER_DURATION = 1500;
  const counterObs = new IntersectionObserver(entries => {
    entries.forEach(e => {
      if (!e.isIntersecting) return;
      const el  = e.target as HTMLElement;
      const end = parseInt(el.dataset.count ?? '0', 10);
      const sfx = el.dataset.suffix ?? '';
      const t0  = performance.now();
      const tick = (now: number) => {
        const p  = Math.min((now - t0) / COUNTER_DURATION, 1);
        const ep = 1 - Math.pow(1 - p, 3);
        el.textContent = Math.round(ep * end) + sfx;
        if (p < 1) requestAnimationFrame(tick);
      };
      requestAnimationFrame(tick);
      counterObs.unobserve(el);
    });
  }, { threshold: 0.5 });
  document.querySelectorAll('[data-count]').forEach(el => counterObs.observe(el));

  // â”€â”€ Cleanup al navegar â”€â”€
  document.addEventListener('astro:before-swap', () => {
    mascotaObserver?.disconnect();
    revealObs.disconnect();
    counterObs.disconnect();
  }, { once: true });
</script>

