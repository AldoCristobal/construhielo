<?php
/**
 * Plantilla de configuración — ConstruHielo
 *
 * 1. Copia este archivo como .env.php en el mismo directorio
 * 2. Rellena los valores reales
 * 3. NUNCA subas .env.php al repositorio (ya está en .gitignore)
 *
 * ── HostGator / cPanel (recomendado) ─────────────────────────
 * Usa el correo corporativo del hosting. No necesitas App Password.
 * La contraseña es la misma que usas para entrar al webmail.
 */

define('GMAIL_USER',     'ruizyair@construhielo.com.mx');  // Correo que ENVÍA
define('GMAIL_PASS',     'password-del-correo');            // Contraseña del correo
define('MAIL_TO',        'ruizyair@construhielo.com.mx');  // Dónde llegan los correos
define('MAIL_NAME',      'ConstruHielo Web');               // Nombre del remitente
define('ALLOWED_ORIGIN', 'https://construhielo.com.mx');   // Dominio del sitio

// Opcional — solo si tu hosting usa un host SMTP diferente
// define('SMTP_HOST', 'mail.construhielo.com.mx');  // por defecto
// define('SMTP_PORT', 465);                          // por defecto (SSL)

/**
 * ── Gmail alternativo ─────────────────────────────────────────
 * Si prefieres usar Gmail en lugar del correo del hosting:
 * 1. Activa verificación en 2 pasos en tu cuenta Google
 * 2. Ve a: https://myaccount.google.com/apppasswords
 * 3. Crea una App Password para "ConstruHielo Web"
 * 4. Cambia SMTP_HOST y SMTP_PORT:
 *
 * define('GMAIL_USER',     'tucuenta@gmail.com');
 * define('GMAIL_PASS',     'xxxx xxxx xxxx xxxx');  // App Password de 16 chars
 * define('MAIL_TO',        'tucuenta@gmail.com');
 * define('SMTP_HOST',      'smtp.gmail.com');
 * define('SMTP_PORT',      587);  // STARTTLS para Gmail
 */
